```gitignore
# ==============================
# Python cache and testing
# ==============================
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# Python virtual environments
venv/
.venv/
env/
ENV/

# ==============================
# Node.js and Next.js
# ==============================
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

.next/
out/
build/
dist/
coverage/

# Next.js / TypeScript
*.tsbuildinfo
next-env.d.ts

# ==============================
# Environment files and secrets
# ==============================
.env
.env.*
!.env.example

# ==============================
# Logs and temporary files
# ==============================
*.log
*.tmp
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ==============================
# Deployment
# ==============================
.vercel/

# ==============================
# VS Code settings
# ==============================
.vscode/

# ==============================
# Personal and local files
# ==============================
sample_resume.pdf
project_files.txt

# ==============================
# Operating system
# ==============================
.DS_Store
Thumbs.db

# ==============================
# Certificates and local keys
# ==============================
*.pem
```